# ==============================================================================
# Mercado Central 24h — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas configurações:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Opcional)
# ------------------------------------------------------------------------------
# Chave de API do Google Gemini para embeddings e geração online (gemini-2.5-flash).
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
#
# NOTA DE OPERAÇÃO:
# - Com a chave configurada: O agente utiliza o modelo text-embedding-004 e gemini-2.5-flash.
# - Sem a chave (deixe vazio): O agente opera 100% OFFLINE / GRATUITO usando o motor de
#   embeddings determinístico de 768 dimensões e geração extrativa com citação de fontes.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Configurações do Streamlit (Opcional)
# ------------------------------------------------------------------------------
# Porta de execução do servidor web Streamlit (padrão: 8501)
STREAMLIT_SERVER_PORT=8501

# Endereço de bind do servidor (0.0.0.0 para aceitar conexões externas / Docker)
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Modo headless (obrigatório para servidores e Docker)
STREAMLIT_SERVER_HEADLESS=true

# ------------------------------------------------------------------------------
# 3. Configurações de Logging (Opcional)
# ------------------------------------------------------------------------------
# Nível de logging da aplicação (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
